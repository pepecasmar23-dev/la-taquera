# Copia este archivo a ".env" y rellena tus valores reales.
# ".env" NUNCA se sube a git (ya está en .gitignore) y NUNCA aparece en el HTML del sitio.

# Credenciales de Mercado Pago (panel: Tu negocio > Configuración > Credenciales)
# Usa SIEMPRE credenciales de PRUEBA (prefijo TEST-) mientras validas que todo funcione.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# Secreto de firma del webhook (panel: Tu negocio > Configuración > Notificaciones webhooks)
MP_WEBHOOK_SECRET=reemplaza-con-tu-clave-secreta-de-webhook

# Llave compartida para proteger el endpoint de reembolsos (invéntate una larga y aleatoria)
ADMIN_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# URL pública base del sitio (para construir back_urls y notification_url de Mercado Pago).
# En pruebas locales sin túnel público, Mercado Pago NO podrá alcanzar tu webhook —
# ver README.md para las opciones (ngrok / hosting real).
PUBLIC_BASE_URL=http://localhost:3000

PORT=3000
